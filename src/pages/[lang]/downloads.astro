---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import ConstructionBanner from "../../components/site/ConstructionBanner.astro";
import SiteNav from "../../components/site/SiteNav.astro";
import DownloadsSection, {
  type DownloadFile,
} from "../../components/site/DownloadsSection.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import CookieConsent from "../../components/site/CookieConsent.astro";
import SiteScripts from "../../components/site/SiteScripts.astro";
import {
  defaultCookieConsent,
  defaultLang,
  getDictionary,
  languages,
  type Lang,
} from "../../i18n";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = (Astro.params.lang ?? defaultLang) as Lang;
const dict = getDictionary(lang);

const downloadsRoot = path.join(process.cwd(), "public", "downloads");

function collectFiles(dir: string): DownloadFile[] {
  if (!fs.existsSync(dir)) return [];
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .filter((entry) => entry.isFile() && entry.name !== ".gitkeep")
    .map((entry) => ({ name: entry.name, href: `/downloads/${entry.name}` }));
}

const files = collectFiles(downloadsRoot).sort((a, b) =>
  a.name.localeCompare(b.name)
);
---

<Layout title={dict.meta.title} lang={lang}>
  <CookieConsent t={"cookieConsent" in dict ? dict.cookieConsent : defaultCookieConsent} />
  <ConstructionBanner t={dict.constructionBanner} />
  <SiteNav lang={lang} t={dict.nav} />
  <DownloadsSection t={dict.downloadsSection} files={files} />
  <SiteFooter lang={lang} t={dict.footer} />
  <SiteScripts />
</Layout>
