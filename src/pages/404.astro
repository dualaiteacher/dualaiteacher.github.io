---
import Layout from "../layouts/Layout.astro";
import ConstructionBanner from "../components/site/ConstructionBanner.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import CookieConsent from "../components/site/CookieConsent.astro";
import SiteScripts from "../components/site/SiteScripts.astro";
import {
  defaultCookieConsent,
  defaultLang,
  getDictionary,
  isLang,
  type Lang,
} from "../i18n";

const pathLang = Astro.url.pathname.split("/")[1];
const lang: Lang = isLang(pathLang) ? pathLang : defaultLang;
const dict = getDictionary(lang);
---

<Layout title={dict.notFound.metaTitle} lang={lang}>
  <CookieConsent t={"cookieConsent" in dict ? dict.cookieConsent : defaultCookieConsent} />
  <div class="min-h-screen flex flex-col">
    <ConstructionBanner t={dict.fundingBanner} />

    <header class="sticky top-0 z-50 bg-white border-b-4 border-accent shadow-sm">
      <div class="mx-auto px-4 py-4">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center no-underline hover:no-underline"
        >
          <img
            src="/dual-ai-navbar.png"
            alt="DUAL.AI.TEACHer"
            class="h-10 sm:h-12 ml-6 w-auto"
          />
        </a>
      </div>
    </header>

    <main
      class="flex-1 flex items-center justify-center py-24 px-6 bg-brand text-white relative overflow-hidden"
    >
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-pattern-dark"></div>

      <div class="max-w-3xl text-center relative z-10">
        <p class="text-accent text-2xl md:text-3xl font-black uppercase tracking-[0.2em] mb-4">
          {dict.notFound.label}
        </p>
        <h1 class="text-5xl md:text-7xl font-black leading-tight tracking-tight mb-8">
          {dict.notFound.title}
        </h1>
        <p class="text-xl md:text-2xl text-slate-200 leading-relaxed mb-16 md:mb-20 font-medium">
          {dict.notFound.body}
        </p>

        <div class="flex items-center justify-center">
          <a
            href={`/${lang}/`}
            class="inline-flex items-center justify-center px-10 py-5 text-xl font-black uppercase tracking-wide text-brand bg-accent hover:bg-accent-hover rounded-full transition-all  hover:scale-105"
          >
            {dict.notFound.backHome}
          </a>
        </div>
      </div>
    </main>

    <SiteFooter lang={lang} t={dict.footer} />
  </div>
  <SiteScripts />
</Layout>
