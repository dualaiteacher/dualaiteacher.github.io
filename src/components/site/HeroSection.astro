---
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
  t: {
    titleAccent: string;
    titleRest: string;
    subtitle: string;
    primaryCta: string;
    secondaryCta: string;
  };
}

const { lang, t } = Astro.props;
const homeHref = `/${lang}/`;
const partnersHref = `/${lang}/partners/`;
---

<section
  id="hero"
  class="relative min-h-[88vh] flex items-center justify-center overflow-hidden bg-brand text-white px-6 py-24"
>

  <div class="relative z-10 mx-auto max-w-5xl text-center">
    <h1
      class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[1.02]"
    >
      <span class="block text-accent drop-shadow-[0_6px_14px_rgba(0,0,0,0.18)]">
        {t.titleAccent}
      </span>
      <span class="block text-white drop-shadow-[0_6px_14px_rgba(0,0,0,0.16)]">
        {t.titleRest}
      </span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg md:text-xl leading-8 text-white/85">
      {t.subtitle}
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`${homeHref}#about`}
        class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-bold text-brand transition hover:scale-105"
      >
        {t.primaryCta}
      </a>

      <a
        href={partnersHref}
        class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-base font-semibold text-white/95 backdrop-blur-sm transition hover:bg-white/10"
      >
        {t.secondaryCta}
      </a>
    </div>
  </div>
</section>
