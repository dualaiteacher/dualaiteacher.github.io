---
interface Props {
  t: {
    titleAccent: string;
    titleRest: string;
  };
}

const { t } = Astro.props;
---

<section
  id="hero"
  class="min-h-[90vh] flex flex-col items-center justify-center py-32 px-6 bg-brand text-white relative overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none bg-pattern-dark"
  >
  </div>

  <div
    class="max-w-6xl w-full mx-auto flex flex-col items-center text-center relative z-10"
  >
    <h1
      class="text-5xl md:text-7xl lg:text-8xl font-black text-white tracking-tight leading-[1.05] mb-8 drop-shadow-lg"
    >
      <span class="text-accent">{t.titleAccent}</span><br />
      {t.titleRest}
    </h1>

  </div>
</section>
