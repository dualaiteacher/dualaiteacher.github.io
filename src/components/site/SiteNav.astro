---
import { Image } from "astro:assets";
import LanguagePicker from "./LanguagePicker.astro";
import dualAiNavbar from "../../assets/branding/dual-ai-navbar.png";
import FacebookIcon from "../../assets/icons/facebook.svg";
import InstagramIcon from "../../assets/icons/instagram.svg";
import LinkedInIcon from "../../assets/icons/linkedin.svg";
import YouTubeIcon from "../../assets/icons/youtube.svg";
import { type Lang } from "../../i18n";

const socialLinks = [
  { href: "https://www.linkedin.com/company/dualaiteacher/", label: "LinkedIn", Icon: LinkedInIcon },
  { href: "https://www.instagram.com/dualaiteacher/", label: "Instagram", Icon: InstagramIcon },
  { href: "https://www.facebook.com/dualaiteacher/", label: "Facebook", Icon: FacebookIcon },
  { href: "https://www.youtube.com/@dualaiteacher", label: "YouTube", Icon: YouTubeIcon }
];

interface Props {
  lang: Lang;
  t: {
    what: string;
    why: string;
    how: string;
    partners: string;
    news: string;
    contact: string;
    newsletter: string;
  };
}

const { lang, t } = Astro.props;
const homeHref = `/${lang}/`;
const partnersHref = `/${lang}/partners/`;
const newsHref = `/${lang}/news/`;
const contactHref = `/${lang}/contact/`;
const subscribeHref = `/${lang}/subscribe/`;
---

<nav
  class="sticky top-0 z-50 bg-white border-b-4 border-accent shadow-sm"
>
  <div class="mx-auto px-4 flex items-center py-4 flex-wrap gap-3">
    <a
      href={`${homeHref}`}
      class="flex items-center no-underline hover:no-underline"
    >
      <Image
        src={dualAiNavbar}
        alt="DUAL.AI.TEACHer"
        class="h-10 sm:h-12 ml-6 w-auto"
      />
    </a>
    <ul class="hidden lg:flex gap-8 list-none m-0 p-0 ml-16 flex-wrap">
      <li>
        <a
          href={`${homeHref}#about`}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.what}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#why`}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.why}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#how`}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.how}</a>
      </li>
      <li>
        <a
          href={partnersHref}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.partners}</a>
      </li>
      <li>
        <a
          href={newsHref}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.news}</a>
      </li>
      <li>
        <a
          href={contactHref}
          class="text-base font-bold text-slate-600 hover:text-brand no-underline transition-colors uppercase tracking-wide"
         >{t.contact}</a>
      </li>
    </ul>
    <div class="hidden lg:flex items-center gap-3 ml-auto">
            <a
        href={subscribeHref}
        class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-amber-950 no-underline transition hover:scale-105"
      >
        {t.newsletter}
      </a>
      {socialLinks.map(({ href, label, Icon }) => (
        <a
          href={href}
          aria-label={label}
          class="inline-flex h-10 w-10 items-center justify-center text-brand transition-transform duration-200 hover:-translate-y-0.5 hover:scale-110 hover:text-accent"
        >
          <Icon class="block h-6 w-6" aria-hidden="true" focusable="false" />
        </a>
      ))}

    </div>
    <button
      id="mobileMenuBtn"
      class="lg:hidden ml-auto p-2 rounded-lg hover:bg-surface-2 transition-colors cursor-pointer border-0 bg-transparent text-brand"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
    </button>
  </div>

  <div
    id="mobileMenu"
    class="hidden lg:hidden border-t border-surface-3 bg-white px-6 pb-6 shadow-xl"
  >
    <div class="pt-4">
      <LanguagePicker lang={lang} mobile={true} />
    </div>
    <ul class="list-none m-0 p-0 flex flex-col gap-2 pt-4">
      <li>
        <a
          href={`${homeHref}#about`}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.what}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#why`}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.why}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#how`}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.how}</a>
      </li>
      <li>
        <a
          href={partnersHref}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.partners}</a>
      </li>
      <li>
        <a
          href={newsHref}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.news}</a>
      </li>
      <li>
        <a
          href={contactHref}
          class="block py-3 text-lg font-black text-brand uppercase border-b border-slate-100"
         >{t.contact}</a>
      </li>
    </ul>
    <a
      href={subscribeHref}
      class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-bold text-amber-950 no-underline transition hover:scale-[1.02]"
    >
      {t.newsletter}
    </a>
    <div class="flex items-center gap-3 pt-4">
      {socialLinks.map(({ href, label, Icon }) => (
        <a
          href={href}
          aria-label={label}
          class="inline-flex h-10 w-10 items-center justify-center text-brand transition-transform duration-200 hover:-translate-y-0.5 hover:scale-110 hover:text-accent"
        >
          <Icon class="block h-6 w-6" aria-hidden="true" focusable="false" />
        </a>
      ))}
    </div>
  </div>
</nav>
