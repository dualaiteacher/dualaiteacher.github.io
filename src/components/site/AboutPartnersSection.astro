---
import FacebookIcon from "../../assets/icons/facebook.svg";
import InstagramIcon from "../../assets/icons/instagram.svg";
import LinkedInIcon from "../../assets/icons/linkedin.svg";

interface Props {
  t: {
    label: string;
    title: string;
    lead: string;
    partners: {
      type: string;
      name: string;
      country: string;
      website?: string;
      facebook?: string;
      instagram?: string;
      linkedin?: string;
    }[];
  };
}

const { t } = Astro.props;
---

<section
  id="about-partners"
  class="py-24 md:py-32 bg-accent relative border-b-4 border-brand/20 overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none bg-pattern-dark"
  >
  </div>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-14">
      <span
        class="inline-block text-sm font-black tracking-widest uppercase text-white bg-brand px-4 py-1.5 rounded-full mb-4 shadow-lg"
       
      >
        {t.label}
      </span>
      <h2
        class="text-[clamp(2.2rem,7vw,4.2rem)] font-black leading-tight text-brand tracking-tight"
       
      >
        {t.title}
      </h2>
      <p
        class="text-xl md:text-2xl text-slate-600/90 max-w-4xl mx-auto font-bold leading-relaxed mt-5"
       
      >
        {t.lead}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {t.partners.map((partner, index) => (
        <div
          class:list={[
            "group bg-white rounded-2xl border-t-4 border-brand p-5 shadow-md transition-all",
            partner.website && "hover:-translate-y-1 hover:shadow-xl",
            partner.website && "cursor-pointer",
          ]}
          role={partner.website ? "link" : undefined}
          tabindex={partner.website ? "0" : undefined}
          data-href={partner.website || undefined}
          onclick={partner.website
            ? "const href=this.getAttribute('data-href');if(href){window.location.href=href;}"
            : undefined}
          onkeydown={partner.website
            ? "const keyboardEvent=arguments[0];const href=this.getAttribute('data-href');if((keyboardEvent.key==='Enter'||keyboardEvent.key===' ')&&href){keyboardEvent.preventDefault();window.location.href=href;}"
            : undefined}
        >
          <p
            class:list={[
              "inline-flex text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full mb-3",
              index === 0 || index === 5
                ? "text-brand bg-white border-2 border-brand"
                : index === 1 || index === 3 || index === 7 || index === 8 || index === 9 || index === 10
                  ? "text-white bg-brand"
                  : index === 2
                    ? "text-brand bg-accent"
                    : index === 4
                      ? "text-brand bg-white border-2 border-accent"
                      : "text-accent bg-brand",
            ]}
          >
            {partner.type}
          </p>
          <p class="text-xl md:text-2xl font-black text-brand leading-snug tracking-tight notranslate">
            {partner.name}
          </p>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-600/80 mt-2">
            {partner.country}
          </p>
          <div class="flex items-center justify-between gap-4 mt-4">
            <div class="w-10 h-1 rounded-full bg-accent"></div>
            <div class="flex items-center gap-2">
              {partner.facebook && (
                <a
                  href={partner.facebook}
                  onclick="arguments[0].stopPropagation()"
                  aria-label={`${partner.name} on Facebook`}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-brand transition-colors hover:border-brand hover:bg-accent/30"
                >
                  <FacebookIcon class="block h-4 w-4" aria-hidden="true" focusable="false" />
                </a>
              )}
              {partner.instagram && (
                <a
                  href={partner.instagram}
                  onclick="arguments[0].stopPropagation()"
                  aria-label={`${partner.name} on Instagram`}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-brand transition-colors hover:border-brand hover:bg-accent/30"
                >
                  <InstagramIcon class="block h-4 w-4" aria-hidden="true" focusable="false" />
                </a>
              )}
              {partner.linkedin && (
                <a
                  href={partner.linkedin}
                  onclick="arguments[0].stopPropagation()"
                  aria-label={`${partner.name} on LinkedIn`}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-brand transition-colors hover:border-brand hover:bg-accent/30"
                >
                  <LinkedInIcon class="block h-4 w-4" aria-hidden="true" focusable="false" />
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

