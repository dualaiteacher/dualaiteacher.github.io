---
interface Props {
  t: {
    eyebrow: string;
    title: string;
    lead: string;
    partners: {
      type: string;
      name: string;
      country: string;
    }[];
  };
}

const { t } = Astro.props;
---

<section
  id="about-partners"
  class="py-24 md:py-32 bg-accent relative border-b-4 border-brand/20 overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none bg-pattern-dark"
  >
  </div>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-14">
      <span
        class="inline-block text-sm font-black tracking-widest uppercase text-white bg-brand px-4 py-1.5 rounded-full mb-4 shadow-lg"
       
      >
        {t.eyebrow}
      </span>
      <h2
        class="text-[clamp(2.2rem,7vw,4.2rem)] font-black leading-tight text-brand tracking-tight"
       
      >
        {t.title}
      </h2>
      <p
        class="text-xl md:text-2xl text-slate-600/90 max-w-4xl mx-auto font-bold leading-relaxed mt-5"
       
      >
        {t.lead}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {t.partners.map((partner, index) => (
        <a href="#about-partners" class="group bg-white rounded-2xl border-t-4 border-brand p-5 shadow-md transition-all hover:-translate-y-1 hover:shadow-xl">
          <p
            class:list={[
              "inline-flex text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full mb-3",
              index === 0 || index === 5
                ? "text-brand bg-white border-2 border-brand"
                : index === 1 || index === 3 || index === 7 || index === 8 || index === 9 || index === 10
                  ? "text-white bg-brand"
                  : index === 2
                    ? "text-brand bg-accent"
                    : index === 4
                      ? "text-brand bg-white border-2 border-accent"
                      : "text-accent bg-brand",
            ]}
          >
            {partner.type}
          </p>
          <p class="text-xl md:text-2xl font-black text-brand leading-snug tracking-tight notranslate">
            {partner.name}
          </p>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-600/80 mt-2">
            {partner.country}
          </p>
          <div class="w-10 h-1 rounded-full bg-accent mt-4"></div>
        </a>
      ))}
    </div>
  </div>
</section>

