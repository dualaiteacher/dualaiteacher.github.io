---
interface Props {
  t: {
    with: {
      titleStart: string;
      titleAccent: string;
      titleEnd: string;
      label: string;
      body: string;
    };
    about: {
      titleStart: string;
      titleAccent: string;
      titleEnd: string;
      label: string;
      body: string;
    };
  };
}

const { t } = Astro.props;
---

<section
  id="dual"
  class="py-24 md:py-32 bg-white relative border-b border-surface-3 overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.02] bg-pattern-light pointer-events-none"
  >
  </div>

    <div
      class="relative flex flex-col md:flex-row items-stretch justify-between w-full max-w-5xl mx-auto gap-12 md:gap-0"
    >
      <div
        class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 bg-slate-200 transform -translate-x-1/2 rounded-full"
      >
        <div
          class="absolute top-1/2 left-1/2 w-3 h-32 bg-accent rounded-full transform -translate-x-1/2 -translate-y-1/2 shadow-[0_0_15px_rgba(255,204,0,0.6)]"
        >
        </div>
      </div>

      <div
        class="w-full md:w-[45%] flex flex-col items-center md:items-end text-center md:text-right"
      >
        <div
          class="w-24 h-24 rounded-full bg-slate-50 text-brand flex items-center justify-center mb-8 shadow-sm border-2 border-brand/20"
        >
          <svg
            class="w-12 h-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
            ></path></svg
          >
        </div>
        <h3
          class="text-4xl md:text-5xl font-black mb-6 text-brand tracking-tight"
         
        >
          {t.with.titleStart} <em
            class="text-accent not-italic border-b-4 border-accent pb-1"
            >{t.with.titleAccent}</em
          > {t.with.titleEnd}
        </h3>
        <p
          class="text-xl text-slate-600 leading-relaxed font-medium"
         
        >
          <strong class="text-brand font-black">{t.with.label}</strong>
          {" "}
          {t.with.body}
        </p>
      </div>

      <div
        class="block md:hidden w-full h-1 bg-slate-200 rounded-full relative"
      >
        <div
          class="absolute top-1/2 left-1/2 w-24 h-2 bg-accent rounded-full transform -translate-x-1/2 -translate-y-1/2 shadow-[0_0_10px_rgba(255,204,0,0.5)]"
        >
        </div>
      </div>

      <div
        class="w-full md:w-[45%] flex flex-col items-center md:items-start text-center md:text-left"
      >
        <div
          class="w-24 h-24 rounded-full bg-slate-50 text-brand flex items-center justify-center mb-8 shadow-sm border-2 border-brand/20"
        >
          <svg
            class="w-12 h-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M9 18h6"></path><path d="M10 22h4"></path><path
              d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"
            ></path></svg
          >
        </div>
        <h3
          class="text-4xl md:text-5xl font-black mb-6 text-brand tracking-tight"
         
        >
          {t.about.titleStart} <em
            class="text-accent not-italic border-b-4 border-accent pb-1"
            >{t.about.titleAccent}</em
          > {t.about.titleEnd}
        </h3>
        <p
          class="text-xl text-slate-600 leading-relaxed font-medium"
         
        >
          <strong class="text-brand font-black">{t.about.label}</strong>{" "}
          {t.about.body}
        </p>
      </div>
    </div>
  </div>
</section>

