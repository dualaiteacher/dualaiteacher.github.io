---
interface Props {
  t: {
    construction: string;
    euFunding: string;
    euFlagAlt: string;
  };
}

const { t } = Astro.props;
---

<div
  class="bg-amber-300 text-amber-950 py-2 px-4 text-center text-xs md:text-sm font-extrabold flex items-center justify-center gap-3 relative tracking-wider uppercase"
>
  <span aria-hidden="true">!</span>
  <span>{t.construction}</span>
  <span aria-hidden="true">!</span>
</div>

