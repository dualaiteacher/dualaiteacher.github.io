---
interface Props {
  t: {
    eyebrow: string;
    title: string;
    lead: string;
    body: string;
  };
}

const { t } = Astro.props;
---

<section
  id="about"
  class="py-32 md:py-40 bg-slate-50 relative overflow-hidden border-b border-surface-3"
>
  <div
    class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col md:flex-row gap-12 lg:gap-20 items-center"
  >
    <div class="w-full md:w-1/2 lg:w-7/12">
      <span
        class="inline-flex items-center gap-3 text-sm font-black tracking-widest uppercase text-brand mb-8"
      >
        <span class="w-10 h-1 bg-accent rounded-full"></span>
        <span>{t.eyebrow}</span>
      </span>

      <h2
        class="text-5xl md:text-6xl lg:text-[5rem] font-black leading-[1.05] text-brand tracking-tight"
       
      >
        {t.title}
      </h2>
    </div>

    <div
      class="w-full md:w-1/2 lg:w-5/12 border-l-4 border-accent pl-6 md:pl-10 py-2"
    >
      <p
        class="text-2xl text-slate-800 mb-6 leading-snug font-bold tracking-tight"
       
      >
        {t.lead}
      </p>

      <p class="text-lg text-slate-600 leading-relaxed font-medium">
        {t.body}
      </p>
    </div>
  </div>
</section>

