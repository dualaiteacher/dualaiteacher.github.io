---
interface Props {
  t: {
    label: string;
    title: string;
    lead: string;
    phases: {
      title: string;
      body: string;
    }[];
  };
}

const { t } = Astro.props;
---

<section
  id="how"
  class="py-32 px-6 bg-brand text-white relative overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none bg-pattern-dark"
  >
  </div>

  <div class="max-w-6xl w-full mx-auto relative z-10">
    <div class="text-center mb-24 space-y-6">
      <span
        class="bg-accent text-brand text-sm font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-[0_0_15px_rgba(255,204,0,0.4)]"
       
        >{t.label}</span
      >
      <h2
        class="text-5xl md:text-6xl font-black text-white tracking-tight mt-6"
       
      >
        {t.title}
      </h2>
      <p
        class="text-2xl text-slate-50 max-w-3xl mx-auto font-medium"
       
      >
        {t.lead}
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto py-10">
      <div
        class="absolute left-8 md:left-1/2 top-0 bottom-0 w-2 bg-accent transform md:-translate-x-1/2 rounded-full shadow-[0_0_20px_rgba(0,51,153,0.8)]"
      >
      </div>

      {
        t.phases.map((phase, index) => (
          <div
            class:list={[
              "relative flex items-center justify-between w-full",
              index < t.phases.length - 1 ? "mb-28" : "",
            ]}
          >
            <div
              class="absolute left-8 md:left-1/2 w-16 h-16 rounded-full bg-brand border-4 border-accent shadow-[0_0_25px_rgba(255,204,0,0.6)] transform -translate-x-1/2 flex items-center justify-center z-10"
            >
              <span class="text-accent font-black text-2xl">{index + 1}</span>
            </div>
            <div
              class:list={[
                "w-full md:w-[45%] ml-20 bg-white/10 backdrop-blur-md border-2 border-blue-400/30 p-10 rounded-3xl shadow-2xl relative overflow-hidden",
                index % 2 === 0 ? "md:ml-0 md:mr-auto" : "md:ml-auto md:mr-0",
              ]}
            >
              <div
                class="absolute -right-4 -bottom-10 text-9xl font-black text-white/5 select-none pointer-events-none"
              >
                {String(index + 1).padStart(2, "0")}
              </div>
              <h3 class="text-3xl font-black text-accent mb-4">
                {phase.title}
              </h3>
              <p class="text-slate-200 leading-relaxed text-lg font-medium">
                {phase.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>


