---
interface Props {
  t: {
    label: string;
    title: string;
    lead: string;
    items: {
      title: string;
      body: string;
    }[];
  };
}

const { t } = Astro.props;
---

<section
  id="why"
  class="py-24 md:py-32 bg-brand text-white relative overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-[0.03] bg-pattern-dark pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-24">
      <span
        class="inline-block text-sm font-black tracking-widest uppercase text-brand bg-accent px-4 py-1.5 rounded-full mb-6 shadow-[0_0_15px_rgba(255,204,0,0.4)]"
       
        >{t.label}</span
      >
      <h2
        class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-white mb-6 tracking-tight"
       
      >
        {t.title}
      </h2>
      <p
        class="text-2xl md:text-3xl text-slate-50 max-w-4xl mx-auto font-medium leading-relaxed"
       
      >
        {t.lead}
      </p>
    </div>

    <div class="flex flex-col">
      {
        t.items.map((item, index) => (
          <div
            class:list={[
              "flex flex-col lg:flex-row gap-6 lg:gap-12 items-start lg:items-center pt-12 pb-16",
              index === 0
                ? "border-t border-slate-200/30"
                : index === t.items.length - 1
                  ? "border-y border-slate-200/30"
                  : "border-t border-slate-200/30",
            ]}
          >
            <div
              class="text-7xl md:text-8xl lg:text-9xl font-black text-transparent bg-clip-text bg-linear-to-b from-accent to-accent/20 opacity-80 leading-none shrink-0 w-24 md:w-40"
            >
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="flex-1 lg:w-4/12">
              <h3
                class="text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight"
              >
                {item.title}
              </h3>
            </div>
            <div class="flex-1 lg:w-6/12 mt-4 lg:mt-0">
              <p
                class="text-xl md:text-2xl text-slate-50 leading-relaxed font-medium m-0 pl-0"
              >
                {item.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

