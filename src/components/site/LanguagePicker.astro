---
import { languages, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
  mobile?: boolean;
}

const { lang, mobile = false } = Astro.props;

const entries = Object.entries(languages) as [Lang, string][];
const flags: Record<Lang, string> = {
  cs: "/flags/cs.svg",
  de: "/flags/de.svg",
  en: "/flags/gb.svg",
  es: "/flags/es.svg",
  lv: "/flags/lv.svg",
  pl: "/flags/pl.svg",
  sl: "/flags/si.svg",
  sk: "/flags/sk.svg",
};
const abbreviations: Record<Lang, string> = {
  en: "EN",
  sl: "SI",
  sk: "SK",
  cs: "CS",
  de: "DE",
  es: "ES",
  lv: "LV",
  pl: "PL",
};
---

<div
  class:list={[
    "font-sans",
    mobile ? "relative md:hidden" : "fixed right-8 bottom-16 z-50 hidden md:block",
  ]}
  data-language-picker
>
  <button
    type="button"
    class:list={[
      "inline-flex min-w-0 cursor-pointer items-center gap-3 rounded-full border border-slate-300 bg-white font-bold text-gray-800 shadow-lg hover:bg-slate-50",
      mobile ? "px-4 py-2 text-base" : "px-5 py-3 text-lg",
    ]}
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select language"
    data-language-picker-toggle
  >
    <img
      src={flags[lang]}
      alt=""
      class="h-4 w-5 shrink-0 rounded object-cover shadow-sm"
      width="18"
      height="14"
      loading="eager"
      decoding="async"
    />
    <span>{abbreviations[lang]}</span>
  </button>

  <div
    class:list={[
      "absolute min-w-44 max-h-64 overflow-y-auto rounded-2xl border border-slate-300 bg-white shadow-xl",
      mobile ? "top-full left-0 mt-2" : "right-0 bottom-full mb-2.5",
    ]}
    hidden
    data-language-picker-menu
  >
    {entries.map(([code, label]) => (
      <a
        href={`/${code}/`}
        class:list={[
          "flex items-center gap-2.5 px-3.5 py-3 text-sm font-bold text-gray-800 no-underline hover:bg-slate-50",
          code === lang && "bg-slate-100",
        ]}
        data-lang-link={code}
      >
        <img
          src={flags[code]}
          alt=""
          class="h-4 w-5 shrink-0 rounded-sm object-cover shadow-sm"
          width="20"
          height="15"
          loading="lazy"
          decoding="async"
        />
        {label}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__languagePickerInitialized) return;
    window.__languagePickerInitialized = true;

    function getLocalizedPath(targetLang) {
      var url = new URL(window.location.href);
      var parts = url.pathname.split("/").filter(Boolean);
      var supported = ["en", "sl", "sk", "cs", "de", "es", "lv", "pl"];

      if (parts.length && supported.indexOf(parts[0]) !== -1) {
        parts[0] = targetLang;
      } else {
        parts.unshift(targetLang);
      }

      return "/" + parts.join("/") + "/" + url.search + url.hash;
    }

    function openMenu(toggle, menu) {
      toggle.setAttribute("aria-expanded", "true");
      menu.hidden = false;
    }

    function closeMenu(toggle, menu) {
      toggle.setAttribute("aria-expanded", "false");
      menu.hidden = true;
    }

    var pickers = document.querySelectorAll("[data-language-picker]");
    if (!pickers.length) return;

    pickers.forEach(function (picker) {
      var toggle = picker.querySelector("[data-language-picker-toggle]");
      var menu = picker.querySelector("[data-language-picker-menu]");
      var links = picker.querySelectorAll("[data-lang-link]");

      if (!toggle || !menu) return;

      toggle.addEventListener("click", function () {
        if (menu.hidden) openMenu(toggle, menu);
        else closeMenu(toggle, menu);
      });

      document.addEventListener("click", function (event) {
        if (!picker.contains(event.target)) closeMenu(toggle, menu);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeMenu(toggle, menu);
      });

      links.forEach(function (link) {
        var targetLang = link.getAttribute("data-lang-link");
        if (!targetLang) return;
        link.setAttribute("href", getLocalizedPath(targetLang));
      });
    });
  })();
</script>
