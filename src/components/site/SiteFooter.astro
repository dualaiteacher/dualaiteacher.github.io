---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { type Lang } from "../../i18n";

interface Props {
  lang: Lang;
  t: {
    tagline: string;
    licenseLabel: string;
    nav: {
      what: string;
      why: string;
      how: string;
      partners: string;
      news: string;
      privacy: string;
      downloads: string;
      cookieSettings: string;
    };
    euFlagAlt: string;
    euDisclaimer: string;
  };
}

const { lang, t } = Astro.props;
const currentYear = new Date().getFullYear();
const homeHref = `/${lang}/`;
const partnersHref = `/${lang}/partners/`;
const newsHref = `/${lang}/news/`;
const privacyHref = `/${lang}/privacy/`;
const downloadsHref = `/${lang}/downloads/`;
const euBadgeImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/cofunded/*.png",
  { eager: true }
);
const euBadgeImage = euBadgeImages[`/src/assets/cofunded/${lang}.png`]?.default;

if (!euBadgeImage) {
  throw new Error(`Missing cofunded image for language "${lang}".`);
}
---

<footer
  class="bg-white text-slate-600 py-16 px-6 border-t-8 border-brand"
>
  <div
    class="max-w-4xl mx-auto flex flex-col items-center gap-8 text-center"
  >
    <div class="w-full flex flex-col items-center gap-3">
      <p
        class="text-lg sm:text-2xl font-semibold text-slate-700 leading-relaxed m-0 max-w-3xl"
       
      >
        {t.tagline}
      </p>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed m-0 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <span>ERASMUS-EDU-2025-PEX-TEACH-ACA</span>
        <span aria-hidden="true" class="text-slate-300">|</span>
        <span>101249519</span>
        <span aria-hidden="true" class="text-slate-300">|</span>
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_self"
          rel="noopener noreferrer"
          class="font-semibold text-brand hover:text-accent transition-colors"
         
        >
          {t.licenseLabel}
        </a>
      </p>
      <p class="text-sm text-slate-500 leading-relaxed m-0">
        &copy; {currentYear} DUAL.AI.TEACHer
      </p>
      
    </div>
    <ul class="flex gap-8 list-none p-0 m-0 flex-wrap justify-center">
      <li>
        <a
          href={`${homeHref}#about`}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
         >{t.nav.what}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#why`}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
         >{t.nav.why}</a>
      </li>
      <li>
        <a
          href={`${homeHref}#how`}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
         >{t.nav.how}</a>
      </li>
      <li>
        <a
          href={partnersHref}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
          >{t.nav.partners}</a>
      </li>
      <li>
        <a
          href={newsHref}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
          >{t.nav.news}</a>
      </li>
      <li>
        <a
          href={privacyHref}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
          >{t.nav.privacy}</a>
      </li>
      <li>
        <a
          href={downloadsHref}
          class="text-slate-600 font-bold hover:text-accent no-underline transition-colors uppercase tracking-wide"
          >{t.nav.downloads}</a>
      </li>
      <li>
        <a
          class="text-slate-600 font-bold hover:text-accent cursor-pointer no-underline transition-colors uppercase tracking-wide"
          onclick="openCookieSettings()"
          role="button"
          tabindex="0"
         >{t.nav.cookieSettings}</a>
      </li>
    </ul>
    <div
      class="mt-6 flex max-w-4xl flex-col items-center justify-center gap-4 border-t border-slate-300/50 pt-8 text-sm opacity-80 sm:flex-row sm:items-center sm:gap-3"
    >
      <div class="bg-white rounded-md p-1.5 shrink-0">
        <Image
          src={euBadgeImage}
          alt={t.euFlagAlt}
          class="h-10 w-auto"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="text-center leading-relaxed sm:text-left">
        {t.euDisclaimer}
      </p>
    </div>
  </div>
</footer>
