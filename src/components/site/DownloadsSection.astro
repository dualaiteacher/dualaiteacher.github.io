---
export interface DownloadFile {
  name: string;
  href: string;
}

interface Props {
  t: {
    label: string;
    title: string;
    lead: string;
    emptyState: string;
  };
  files: DownloadFile[];
}

const { t, files } = Astro.props;

const typeGroups = [
  { key: "image", label: "Images", extensions: ["jpg", "jpeg", "png", "gif", "webp", "svg"] },
  { key: "video", label: "Videos", extensions: ["mp4", "mov", "webm"] },
  { key: "document", label: "Documents", extensions: ["pdf", "doc", "docx", "ppt", "pptx"] },
  { key: "other", label: "Other", extensions: [] as string[] },
];

function extensionOf(name: string): string {
  return name.split(".").pop()?.toLowerCase() ?? "";
}

const groups = typeGroups
  .map((group) => ({
    ...group,
    files:
      group.key === "other"
        ? files.filter(
            (file) =>
              !typeGroups
                .slice(0, -1)
                .some((g) => g.extensions.includes(extensionOf(file.name)))
          )
        : files.filter((file) => group.extensions.includes(extensionOf(file.name))),
  }))
  .filter((group) => group.files.length > 0);
---

<section
  id="downloads"
  class="py-24 md:py-32 bg-white relative border-b-4 border-brand/20"
>
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-14">
      <span
        class="inline-block text-sm font-black tracking-widest uppercase text-white bg-brand px-4 py-1.5 rounded-full mb-4 shadow-lg"
      >
        {t.label}
      </span>
      <h1
        class="text-[clamp(2.2rem,7vw,4.2rem)] font-black leading-tight text-brand tracking-tight"
      >
        {t.title}
      </h1>
      <p
        class="text-xl md:text-2xl text-slate-600/90 max-w-3xl mx-auto font-bold leading-relaxed mt-5"
      >
        {t.lead}
      </p>
    </div>

    {groups.length === 0 ? (
      <p class="text-center text-slate-500 font-semibold">{t.emptyState}</p>
    ) : (
      <div class="flex flex-col gap-4">
        {groups.map((group) => (
          <details
            class="group bg-white rounded-2xl border-t-4 border-brand p-5 shadow-md open:shadow-xl"
            open
          >
            <summary
              class="cursor-pointer list-none text-xl md:text-2xl font-black text-brand tracking-tight flex items-center justify-between"
            >
              <span>{group.label}</span>
              <span class="text-sm font-bold text-slate-600/80 group-open:rotate-180 transition-transform">▾</span>
            </summary>

            <ul class="list-none p-0 m-0 mt-4 flex flex-col gap-2">
              {group.files.map((file) => (
                <li>
                  <a
                    href={file.href}
                    download
                    class="flex items-center justify-between gap-4 bg-white rounded-xl px-4 py-3 border border-slate-200 hover:border-brand hover:bg-accent/30 transition-colors no-underline"
                  >
                    <span class="text-slate-700 font-semibold break-all">{file.name}</span>
                    <span class="shrink-0 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full text-brand bg-accent">
                      {extensionOf(file.name).toUpperCase() || "FILE"}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    )}
  </div>
</section>
