---
import type { SubscribeSectionTranslation } from "../../i18n";

interface Props {
  t: SubscribeSectionTranslation;
}

const { t } = Astro.props;

const MAILERLITE_ACCOUNT_ID = "2484956";
const MAILERLITE_FORM_ID = "pNX7Xd";
---

<section
  id="subscribe"
  class="py-16 bg-surface-2 relative overflow-hidden border-b border-surface-3"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-brand tracking-tight"
      >
        {t.title}
      </h1>

      <p
        class="mx-auto mt-6 max-w-3xl text-xl md:text-2xl text-slate-600 leading-relaxed font-medium"
      >
        {t.lead}
      </p>
    </div>

    <div class="mx-auto max-w-2xl">
      <div class="overflow-hidden rounded-2xl bg-surface-1 shadow-xl px-6 py-8 md:px-10">
        <div class="ml-embedded" data-form={MAILERLITE_FORM_ID}></div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ MAILERLITE_ACCOUNT_ID }}>
  (function (w, d, e, u, f, l, n) {
    w[f] =
      w[f] ||
      function () {
        (w[f].q = w[f].q || []).push(arguments);
      };
    (l = d.createElement(e)), (l.async = 1), (l.src = u);
    (n = d.getElementsByTagName(e)[0]), n.parentNode.insertBefore(l, n);
  })(
    window,
    document,
    "script",
    "https://assets.mailerlite.com/js/universal.js",
    "ml",
  );
  ml("account", MAILERLITE_ACCOUNT_ID);
</script>
